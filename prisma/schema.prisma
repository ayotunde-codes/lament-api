generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  logo      String?
  industry  Industry
  createdAt DateTime   @default(now())
  reviews   Review[]
}

model Review {
  id          String           @id @default(cuid())
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id])
  username    String
  avatar      String
  avatarColor String
  rating      Int
  heading     String
  body        String
  emoji       String?
  voiceUrl    String?
  tags        String[]         @default([])
  tenure      Tenure?
  role        Role?
  status      EmploymentStatus?
  createdAt   DateTime         @default(now())
  reactions   Reaction[]
  comments    Comment[]
}

model Reaction {
  id          String       @id @default(cuid())
  reviewId    String
  review      Review       @relation(fields: [reviewId], references: [id])
  type        ReactionType
  fingerprint String
  createdAt   DateTime     @default(now())

  @@unique([reviewId, fingerprint])
  @@index([reviewId, type])
}

model Comment {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id])
  username    String
  avatar      String
  avatarColor String
  body        String
  createdAt   DateTime @default(now())

  @@index([reviewId, createdAt])
}

enum Industry {
  TECH
  FINANCE
  HEALTHCARE
  EDUCATION
  RETAIL
  MEDIA
  GOVERNMENT
  ENERGY
  MANUFACTURING
  OTHER
}

enum ReactionType {
  REAL_TEA
  CAP
  HOT_TAKE
  HELPFUL
  TOO_REAL
}

enum Tenure {
  LT_1Y
  ONE_TO_TWO_Y
  THREE_TO_FIVE_Y
  FIVE_PLUS_Y
  INTERVIEW
}

enum Role {
  ENGINEERING
  DESIGN
  PRODUCT
  SALES
  MARKETING
  OPS
  HR
  FINANCE
  CUSTOMER_SUPPORT
  OTHER
}

enum EmploymentStatus {
  CURRENT
  FORMER
  INTERVIEWED
}
